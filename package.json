{
  "name": "@vnidrop/tauri-plugin-share",
  "version": "1.0.0-rc",
  "author": "AbassHammed",
  "description": "A Tauri plugin for sharing content via the system's share dialog.",
  "type": "module",
  "types": "./dist-js/index.d.ts",
  "main": "./dist-js/index.cjs",
  "module": "./dist-js/index.js",
  "exports": {
    "types": "./dist-js/index.d.ts",
    "import": "./dist-js/index.js",
    "require": "./dist-js/index.cjs"
  },
  "files": [
    "dist-js",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "test": "vitest run",
    "test:android:jvm": "cd android && gradle testDebugUnitTest",
    "test:ios": "cd ios && VNIDROP_SHARE_USE_TAURI_STUB=1 swift test",
    "test:types": "tsc -p tsconfig.test.json --noEmit",
    "example:install": "cd examples/tauri-app && npm install",
    "example:build": "cd examples/tauri-app && npm run build",
    "example:check": "npm run example:install && npm run example:build && cd examples/tauri-app/src-tauri && cargo check",
    "check": "bun run build && bun run test && bun run test:types && cargo test"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^25.9.3",
    "rollup": "^4.62.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "picomatch": "4.0.4"
  }
}
